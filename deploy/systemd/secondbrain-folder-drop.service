[Unit]
Description=Secondbrain Folder Drop Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secondbrain-drop
WorkingDirectory=/
ExecStart=/usr/local/bin/secondbrain-folder-drop run --config /etc/secondbrain-folder-drop/config.yaml
EnvironmentFile=-/etc/default/secondbrain-folder-drop
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
